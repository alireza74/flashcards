# Vorlage: kopieren nach .env.local und Werte eintragen. .env.local wird nicht committet.
# Werte fuer lokal: in backend/ "npm run db:status" -> API_URL und PUBLISHABLE_KEY.
#
# Fuer das Handy (Expo Go) statt 127.0.0.1 die IP-Adresse des Laptops im WLAN eintragen,
# z. B. http://192.168.1.20:54321 - das Handy kennt "127.0.0.1" nur als sich selbst.
EXPO_PUBLIC_SUPABASE_URL=http://127.0.0.1:54321
EXPO_PUBLIC_SUPABASE_PUBLISHABLE_KEY=sb_publishable_...
